<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name="com.yuyan.BaseApplication"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTheme">
        <service
            android:name="com.yuyan.imemodule.service.ImeService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- EmojiCompat 由 YuyanEmojiCompat 自行以 LOAD_STRATEGY_MANUAL 管理，
             androidx 的自动初始化器会重复创建实例并调度字体加载；
             ProcessLifecycleOwner 未被使用。两者均在进程启动前运行，故禁用。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                tools:node="remove" />
        </provider>

        <!-- 单进程应用，未启用 Room 多实例失效通知 -->
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            tools:node="remove" />
    </application>

</manifest>